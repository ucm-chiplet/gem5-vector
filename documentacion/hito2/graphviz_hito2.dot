        pos="s,900,1023 e,832.5,950 900,1016 900,1010.67 " +
            "900,1005.33 900,1000 883.333,1000 866.667,1000 " +
            "850,1000 850,983.333 850,966.667 850,950 " +
            "846.5,950 843,950 839.5,950"];
    distributor -> lane_overview [color="#19734B",
        dir="both",
        tooltip="LaneTask + LaneFragmentKey; Accepted/Retry y " +
