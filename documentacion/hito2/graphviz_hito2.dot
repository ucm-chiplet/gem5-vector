        pos="s,867.5,775 e,832.5,775 860.5,775 853.5,775 " +
            "846.5,775 839.5,775"];
    lane_overview -> interconnect [color="#187C80",
        dir="both",
        tooltip="Paquetes / entrega; Accepted o Retry. TaskKey + " +
