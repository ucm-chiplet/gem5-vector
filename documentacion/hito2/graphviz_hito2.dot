        pos="s,667.5,775 e,505,775 660.5,775 611,775 " +
            "561.5,775 512,775"];
    interconnect -> remote_lane [color="#187C80",
        dir="both",
        tooltip="Rangos, datos y bytes habilitados; recepción y " +
            "contrapresión.",
        pos="s,410,745 e,410,685 410,738 410,722.667 " +
            "410,707.333 410,692"];
    vlsu -> mem_backend [color="#70458A",
        dir="both",
        tooltip="VectorMemoryRequest / VectorMemoryResponse; TaskKey + " +
            "requestId.",
        pos="s,910,745 e,910,665 910,738 910,716 910,694 " +
            "910,672"];
    mem_backend -> gem5_memory [color="#70458A",
        dir="both",
        tooltip="Request/Packet; respuestas, faults y retry.",
        pos="s,950,605 e,950,566 950,598 950,589.667 " +
