        pos="s,950,1023 e,950,977 950,1016 950,1005.33 " +
            "950,994.667 950,984"];
    sequencer -> distributor [color="#19734B",
        dir="both",
        tooltip="ArithmeticTask / UnitCompletion; agregación por " +
