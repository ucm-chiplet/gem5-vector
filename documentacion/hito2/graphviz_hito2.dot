// Arquitectura objetivo del Hito 2: FPU dedicada a coma flotante.
// Render: dot -Tsvg graphviz_hito2.dot -o graphviz_hito2.svg
// Posiciones y recorridos explícitos: no aplicar un layout automático.
// nop2 conserva la geometría al usar dot, neato o un visor Graphviz.
// Lane i aparece en la vista general y se desarrolla en el panel inferior.
// M y T son referencias al mismo servicio, no instancias adicionales.
digraph AraLikeGem5Hito2 {
    graph [layout=nop2, splines=polyline, overlap=true,
        bgcolor="white", pad=0.25, fontname="DejaVu Sans",
        fontsize=19, labelloc=t,
        label="VPU Ara-like · Hito 2\nArquitectura objetivo propuesta"];
    node [shape=box, style="rounded,filled", fixedsize=true,
        fontname="DejaVu Sans", fontsize=11, margin="0.08,0.05",
        color="#355C7D", fontcolor="#17202A", penwidth=1.3];
    edge [color="#355C7D", penwidth=1.5, arrowsize=0.65,
        fontname="DejaVu Sans", fontsize=9];
    subgraph cluster_cpu {
        graph [label="MinorCPU",
            fontsize=13,
            style="rounded,filled", color="#8FB3D9",
            fillcolor="#EAF3FC", penwidth=1.2,
            bb="60,1000,635,1125",
            lp="347,1107"];
        decode [pos="155,1050!",
            width=2.01389, height=0.75000,
            shape="box",
            label=<
<B>Decode</B>
<BR/><FONT POINT-SIZE="10">
Semántica RVV
</FONT>
>,
            fillcolor="#D7EAFB", color="#355C7D",
            tooltip="MinorCPU decodifica; la VPU no recibe opcodes ni " +
                "StaticInst."];
        execute [pos="350,1050!",
            width=2.70833, height=0.75000,
            shape="box",
            label=<
<B>Execute / Commit</B>
<BR/><FONT POINT-SIZE="10">
Varias instrucciones en vuelo
</FONT>
<BR/><FONT POINT-SIZE="10">
Retirada en orden
</FONT>
>,
            fillcolor="#D7EAFB", color="#355C7D",
            tooltip="Ventana aritmética consecutiva; despacho en orden y " +
                "finalizaciones retenidas. vsetvli y CSRs permanecen " +
                "en CPU."];
        cpu_if [pos="550,1050!",
            width=2.01389, height=0.75000,
            shape="box",
            label=<
<B>CpuVectorInterface</B>
<BR/><FONT POINT-SIZE="10">
Comandos / finalizaciones
</FONT>
>,
            fillcolor="#C9E4FA", color="#355C7D",
            tooltip="CommandKey, VectorCommand con configuración/contexto " +
                "FP y VectorCompletion con estado/flags. accepted y " +
                "completed distintos."];
    }
    subgraph cluster_frontend {
        graph [label="Frontend · concurrencia sin chaining",
            fontsize=13,
            style="rounded,filled", color="#88BFA3",
            fillcolor="#EAF7F0", penwidth=1.2,
            bb="660,890,1100,1125",
            lp="880,1107"];
        queue [pos="750,1050!",
            width=2.22222, height=0.75000,
            shape="box",
            label=<
<B>CommandQueue · T</B>
<BR/><FONT POINT-SIZE="10">
FIFO y créditos
</FONT>
>,
            fillcolor="#D6F0E2", color="#355C7D",
            tooltip="Admisión con token; accepted tras almacenar. Crédito " +
                "reservado hasta completed. Consulta OperationTraits " +
                "(T)."];
        sequencer [pos="950,1050!",
            width=2.15278, height=0.75000,
            shape="box",
            label=<
<B>AraSequencer</B>
<BR/><FONT POINT-SIZE="10">
Inicio en orden
</FONT>
<BR/><FONT POINT-SIZE="10">
Varios comandos activos
</FONT>
>,
            fillcolor="#C6EAD6", color="#355C7D",
            tooltip="max_active_commands; agregación por CommandKey. " +
                "Cierre después de todos los writebacks. Sin bypass."];
        distributor [pos="750,950!",
            width=2.29167, height=0.75000,
            shape="box",
            label=<
<B>TaskDistributor · M</B>
<BR/><FONT POINT-SIZE="10">
Tareas / fragmentos
</FONT>
>,
            fillcolor="#D6F0E2", color="#355C7D",
            tooltip="ArithmeticTask, UnitCompletion, TaskKey y " +
                "LaneFragmentKey. Reparto por ancho mediante " +
                "AddressMapper (M)."];
        scoreboard [pos="950,950!",
            width=2.15278, height=0.75000,
            shape="box",
            label=<
<B>Scoreboard</B>
<BR/><FONT POINT-SIZE="10">
RAW / WAR / WAW
</FONT>
<BR/><FONT POINT-SIZE="10">
Reservas arquitectónicas
</FONT>
>,
            fillcolor="#C6EAD6", color="#19734B",
            tooltip="Reservas de registros/grupos hasta cierre completo; " +
                "sin readiness por elemento, renombramiento ni ROB " +
                "vectorial."];
    }
    subgraph cluster_overview {
        graph [label="Backend · vista general",
            fontsize=13,
            style="rounded,filled", color="#D8A85D",
            fillcolor="#FFFAF0", penwidth=1.2,
            bb="290,710,1100,855",
            lp="440,837"];
        interconnect [pos="410,775!",
            width=2.63889, height=0.83333,
            shape="box",
            label=<
<B>Interconexión modular</B>
<BR/><FONT POINT-SIZE="10">
Crossbar inicial + arbitraje
</FONT>
<BR/><FONT POINT-SIZE="10">
Topologías intercambiables
</FONT>
<BR/><FONT POINT-SIZE="10">
Slide1up / Slide1down · .vx
</FONT>
>,
            fillcolor="#D4F0F1", color="#187C80",
            tooltip="Interfaz común: admisión, Retry, entrega, capacidad, " +
                "drain y métricas. Topología seleccionada por configuración; " +
                "consumidores independientes de rutas/arbitraje internos. " +
                "Crossbar inicial: round-robin por destino, límite por " +
                "origen, buffers finitos, latencia y bytes/ciclo. " +
                "TransferKey = TaskKey + transferId. Consumidores obligatorios: " +
                "vslide1up.vx y vslide1down.vx, 8/16/32/64, sin máscara. " +
                "Su ejecutor aplica RVV; la red sólo transporta. " +
                "Otras topologías futuras."];
        lane_overview [pos="750,775!",
            width=2.29167, height=0.83333,
            shape="box",
            label=<
<B>Lane i · × N</B>
<BR/><FONT POINT-SIZE="10">
Ejecución + VRF local
</FONT>
<BR/><FONT POINT-SIZE="10">
Detalle en el panel inferior
</FONT>
>,
            fillcolor="#FFE6B9", color="#A66300",
            tooltip="La misma lane que se desarrolla abajo; no es una " +
                "instancia adicional. LaneTask, Accepted/Retry y " +
                "LaneCompletion. Progreso independiente."];
        vlsu [pos="950,775!",
            width=2.29167, height=0.83333,
            shape="box",
            label=<
<B>AraVLSU · M</B>
<BR/><FONT POINT-SIZE="10">
Unit-stride · 8/16/32/64
</FONT>
<BR/><FONT POINT-SIZE="10">
Un bloque activo + buffers
</FONT>
>,
            fillcolor="#EAD8F3", color="#70458A",
            tooltip="EEW = SEW; un bloque activo hasta cerrar memoria y " +
                "VRF. Buffers de carga/store; accesos por palabra y " +
                "fallback por elemento. Memoria cierra la ventana " +
                "aritmética. Consulta AddressMapper (M)."];
    }
        remote_lane [pos="410,660!",
            width=2.63889, height=0.69444,
            shape="box",
            label=<
<B>Lane j ≠ i</B>
<BR/><FONT POINT-SIZE="10">
Mismos recursos locales
</FONT>
>,
            fillcolor="#FFF1D9", color="#A66300",
            tooltip="Cada lane replica LRF, bancos, ALUs y FPU. " +
                "Recepción no equivale a confirmación de escritura " +
                "(WriteAck)."];
    subgraph cluster_memory {
        graph [label="Memoria gem5",
            fontsize=13,
            style="rounded,filled", color="#B38CC5",
            fillcolor="#F5ECFA", penwidth=1.2,
            bb="830,495,1100,700",
            lp="990,681"];
        mem_backend [pos="950,635!",
            width=2.77778, height=0.83333,
            shape="box",
            label=<
<B>VectorMemoryBackend</B>
<BR/><FONT POINT-SIZE="10">
Traducción / fragmentación
</FONT>
<BR/><FONT POINT-SIZE="10">
Retry y respuesta terminal
</FONT>
>,
            fillcolor="#E1C9EE", color="#70458A",
            tooltip="VectorMemoryRequest/Response: TaskKey + requestId. " +
                "Una respuesta terminal por bloque lógico; un paquete " +
                "físico en vuelo, retry y faults. Fragmentación interna."];
        gem5_memory [pos="950,545!",
            width=2.77778, height=0.58333,
            shape="box",
            label=<
<B>TLB / puertos / memoria</B>
>,
            fillcolor="#EAD8F3", color="#70458A",
            tooltip="Request/Packet; respuestas, faults y retry de gem5."];
    }
    subgraph cluster_lane_detail {
        graph [label="Detalle de Lane i · recursos parametrizables",
            fontsize=13,
            style="rounded,filled", color="#D8A85D",
            fillcolor="#FFF1D9", penwidth=1.2,
            bb="65,90,815,590",
            lp="440,571"];
        lane [pos="220,505!",
            width=2.91667, height=0.75000,
            shape="box",
            label=<
<B>AraLane[i]</B>
<BR/><FONT POINT-SIZE="10">
Contextos / operand requester
</FONT>
>,
            fillcolor="#FFE6B9", color="#A66300",
            tooltip="Varios contextos de fragmento; selección de FU y " +
                "asociación por clave y papel. Completa después de " +
                "WriteAck. Red representada arriba."];
        operands [pos="500,505!",
            width=2.63889, height=0.75000,
            shape="box",
            label=<
<B>Colas de operandos</B>
<BR/><FONT POINT-SIZE="10">
Reserva por fuente / FU
</FONT>
>,
            fillcolor="#FFF6E5", color="#A66300",
            tooltip="Capacidades finitas; reservar antes de leer. Datos, " +
                "ancho y contexto viajan en ExecutionBundle."];
        alu [pos="420,385!",
            width=2.50000, height=1.00000,
            shape="box",
            label=<
<B>ALUs SIMD · × K · T</B>
<BR/><FONT POINT-SIZE="10">
Suma / mul / div / resto enteros
</FONT>
<BR/><FONT POINT-SIZE="10">
8 / 16 / 32 / 64 bits
</FONT>
<BR/><FONT POINT-SIZE="10">
Perfil por operación y ancho
</FONT>
>,
            fillcolor="#FFE6B9", color="#A66300",
            tooltip="Instancias por lane, ancho y ocupación propios. " +
                "vadd entero 8/16/32/64; multiplicación, división y resto " +
                "enteros asignados provisionalmente a ALU en 8/16/32/64. " +
                "Formas .vv y .vx; latencias por concretar en fase 6. Mismo ancho " +
                "en fuentes y resultado, sin widening ni narrowing. Sin unidades " +
                "dedicadas Mul/Div. Consulta OperationTraits (T)."];
        fpu [pos="665,385!",
            width=2.91667, height=1.13889,
            shape="box",
            label=<
<B>FPU SIMD · T</B>
<BR/><FONT POINT-SIZE="10">
Suma / multiplicación / división FP32
</FONT>
<BR/><FONT POINT-SIZE="10">
Redondeo + flags · sólo coma flotante
</FONT>
<BR/><FONT POINT-SIZE="10">
Latencia y créditos propios
</FONT>
>,
            fillcolor="#FFEEDC", color="#BA6B27",
            tooltip="Sólo vfadd.vv, vfmul.vv y vfdiv.vv FP32 como objetivos. " +
                "Recibe contexto FP y devuelve flags; no accede al VRF. " +
                "Progreso independiente de las ALUs, recursos internos " +
                "FP por concretar. Binary16 interno conservado; " +
                "Mul/Div/resto enteros asignados a las ALUs."];
        lrf [pos="220,245!",
            width=2.91667, height=0.83333,
            shape="box",
            label=<
<B>LaneRegisterFile · M</B>
<BR/><FONT POINT-SIZE="10">
Arbitraje por banco
</FONT>
<BR/><FONT POINT-SIZE="10">
Lecturas / writebacks
</FONT>
>,
            fillcolor="#FFE6B9", color="#A66300",
            tooltip="Slice local del VRF; round-robin por banco con " +
                "progreso. VrfAccessKey, ReadResponse, WriteAck/Retry. " +
                "AddressMapper común (M). El enlace con VLSU se " +
                "muestra en la vista general."];
        writeback [pos="500,245!",
            width=2.91667, height=0.83333,
            shape="box",
            label=<
<B>Colas de resultados</B>
<BR/><FONT POINT-SIZE="10">
Créditos por FU
</FONT>
<BR/><FONT POINT-SIZE="10">
Retención hasta WriteAck
</FONT>
>,
            fillcolor="#FFF6E5", color="#A66300",
            tooltip="Reserva antes de ejecutar; ExecutionResult y " +
                "VrfWriteRequest. Mantener resultado hasta confirmar " +
                "escritura."];
        banks [pos="220,145!",
            width=2.91667, height=0.75000,
            shape="box",
            label=<
<B>Bancos del VRF</B>
<BR/><FONT POINT-SIZE="10">
Número, ancho y puertos R/W/RW
</FONT>
>,
            fillcolor="#FFE6B9", color="#A66300",
            tooltip="Latencia e intervalo de acceso configurables. " +
                "Concesión por puerto; sin FIFO de solicitudes " +
                "denegadas."];
        local_notes [pos="565,145!",
            width=5.20833, height=0.69444,
            shape="box",
            label=<
<B>Recursos finitos</B>
<BR/><FONT POINT-SIZE="10">
Contrapresión · latencia ≠ intervalo de iniciación
</FONT>
<BR/><FONT POINT-SIZE="10">
Más ALUs requieren puertos y capacidad de writeback
</FONT>
>,
            fillcolor="#FFF6E5", color="#D8A85D",
            tooltip="Recursos finitos"];
    }
    subgraph cluster_shared {
        graph [label="Servicios y configuración comunes",
            fontsize=13,
            style="rounded,filled", color="#AEB7C2",
            fillcolor="#F5F6F7", penwidth=1.2,
            bb="855,90,1100,465",
            lp="977,449"];
        mapper [pos="977,390!",
            width=3.12500, height=1.13889,
            shape="box",
            label=<
<B>M · AddressMapper</B>
<BR/><FONT POINT-SIZE="10">
Distribuidor, VRF y VLSU
</FONT>
<BR/><FONT POINT-SIZE="10">
Mapeo por bytes / SEW / EEW
</FONT>
<BR/><FONT POINT-SIZE="10">
Sin cola ni latencia
</FONT>
>,
            fillcolor="#FFFFFF", color="#A66300",
            tooltip="Las marcas M remiten a este único servicio " +
                "compartido. Mapeo por registro/rango/geometría a " +
                "lane/banco/fila; elemento íntegro por palabra."];
        support [pos="977,270!",
            width=3.12500, height=1.13889,
            shape="box",
            label=<
<B>T · OperationTraits</B>
<BR/><FONT POINT-SIZE="10">
Admisión y unidades
</FONT>
<BR/><FONT POINT-SIZE="10">
Roles / EEW / EMUL / capacidades
</FONT>
<BR/><FONT POINT-SIZE="10">
Facilita nuevas instrucciones
</FONT>
>,
            fillcolor="#FFFFFF", color="#19734B",
            tooltip="VectorSupport: soporte por operación/ancho/formato, " +
                "clase de unidad y perfil temporal. Las marcas T " +
                "remiten a este servicio común."];
        parameters [pos="977,150!",
            width=3.12500, height=1.13889,
            shape="box",
            label=<
<B>VpuParameters</B>
<BR/><FONT POINT-SIZE="10">
Lanes / bancos / puertos / ALUs
</FONT>
<BR/><FONT POINT-SIZE="10">
Anchos / colas / temporización
</FONT>
<BR/><FONT POINT-SIZE="10">
Validación en VectorEngine
</FONT>
>,
            fillcolor="#FFFFFF", color="#687887",
            tooltip="SEW básico 8/16/32/64 con soporte por operación; " +
                "lane_word_bytes, ancho de FU y VLEN distintos. " +
                "Latencia e intervalo separados. Modelo de interconexión " +
                "seleccionable, inicialmente crossbar."];
    }
        legend [pos="580,44!",
            width=14.02778, height=0.75000,
            shape="box",
            label=<
<B>Flecha doble: envío y retorno · M / T: servicios comunes</B>
<BR/><FONT POINT-SIZE="10">
Sin chaining ni renombramiento · Memoria: un bloque y un paquete en vuelo
</FONT>
<BR/><FONT POINT-SIZE="10">
La lane inferior amplía la vista general · Mul / Div / resto enteros: en ALU
</FONT>
>,
            fillcolor="#FFFFFF", color="#FFFFFF",
            tooltip="Identidad extremo a extremo: CommandKey → TaskKey → " +
                "LaneFragmentKey. VRF: VrfAccessKey; memoria: TaskKey " +
                "+ requestId; red: TaskKey + transferId. Drain de " +
                "reservas, colas, FUs, red, memoria y finalizaciones " +
                "CPU. future/ inactivo; MASKU/SLDU completa, " +
                "routers/flits y widening/narrowing fuera de alcance."];
    decode -> execute [color="#0B4F8A",
        dir="forward",
        tooltip="Macro RVV clasificada.",
        pos="e,252.5,1050 227.5,1050 233.5,1050 239.5,1050 " +
            "245.5,1050"];
    execute -> cpu_if [color="#0B4F8A",
        dir="both",
        tooltip="requestGrant / dispatch; grant, stall, rejected, " +
            "accepted y completed.",
        pos="s,447.5,1050 e,477.5,1050 454.5,1050 " +
            "459.833,1050 465.167,1050 470.5,1050"];
    cpu_if -> queue [color="#0B4F8A",
        dir="both",
        tooltip="dispatch(token, VectorCommand); " +
