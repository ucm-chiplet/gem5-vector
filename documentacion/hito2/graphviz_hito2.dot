        pos="s,750,923 e,750,805 750,916 750,881.333 " +
            "750,846.667 750,812"];
    sequencer -> vlsu [color="#70458A",
        dir="both",
        tooltip="MemoryTask + TaskKey; Accepted/Retry/UnitCompletion.",
        pos="s,1027.5,1050 e,1032.5,775 1034.5,1050 " +
            "1046.33,1050 1058.17,1050 1070,1050 1070,958.333 " +
            "1070,866.667 1070,775 1059.83,775 1049.67,775 " +
            "1039.5,775"];
    vlsu -> lane_overview [color="#70458A",
        dir="both",
        tooltip="Acceso al VRF local: lectura de store / writeback de " +
