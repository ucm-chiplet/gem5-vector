digraph AraLikeGem5 {
    graph [
        rankdir=LR, newrank=true, splines=spline,
        bgcolor="white", pad=0.3, nodesep=0.55, ranksep=0.7,
        fontname="DejaVu Sans", fontsize=20, labelloc=t,
        label=
            "Coprocesador vectorial Ara-like sobre gem5\nBaseline " +
            "FIFO: interfaces y organización por lane"
    ];
    node [
        shape=box, style="rounded,filled", fillcolor="white",
        fontname="DejaVu Sans", fontsize=12, margin="0.18,0.12",
        color="#355C7D", fontcolor="#17202A", penwidth=1.4
    ];
    edge [
        fontname="DejaVu Sans", fontsize=10,
        color="#355C7D", fontcolor="#263238",
        arrowsize=0.7, penwidth=1.6
    ];

    subgraph cluster_cpu {
        label="MinorCPU";
        style="rounded,filled";
        color="#8FB3D9"; fillcolor="#EAF3FC";
        fontname="DejaVu Sans"; fontsize=15; margin=20;

        decode [label=
            "Decode\nOffload soportado: macro RVV " +
            "intacta\nOffload desactivado: ruta nativa"
        , fillcolor="#D7EAFB"];
        execute [label=
            "Execute / Commit\nDependencias escalares e " +
            "inFlightInsts\nvsetvli: configura RVV en " +
            "CPU\nDespacho en Commit; retiro en completed"
        ,
                 fillcolor="#D7EAFB"];
        cpu_if [label=
            "CpuVectorInterface\nConstruye VectorCommand RVV 1.0"
        , fillcolor="#C9E4FA"];
        { rank=same; decode; execute; cpu_if; }

        cpu_if -> execute -> decode [style=invis, weight=100];
        decode -> execute [label="Macro clasificada", color="#0B4F8A",
                           constraint=false];
        execute -> cpu_if [
            dir=both, color="#0B4F8A", constraint=false,
            label=
                "requestGrant / dispatch\ngrant o stall / accepted / " +
                "completed"
        ];
    }

    subgraph cluster_frontend {
        label="Frontend VPU";
        style="rounded,filled";
        color="#88BFA3"; fillcolor="#EAF7F0";
        fontname="DejaVu Sans"; fontsize=15; margin=20;

        queue [label=
            "Admisión / CommandQueue\nFIFO única, profundidad " +
            "configurable\naccepted tras almacenar el comando"
        ,
               fillcolor="#D6F0E2"];
        sequencer [label=
            "AraSequencer\nIssue en orden: una instrucción " +
            "activa\nAgrega tareas antes de completed"
        ,
                   fillcolor="#C6EAD6"];
        distributor [label="TaskDistributor\nReparto y agregación",
                     fillcolor="#D6F0E2"];
        { rank=same; queue; sequencer; distributor; }
        distributor -> sequencer -> queue [style=invis, weight=100];

        queue -> sequencer [
            dir=both, color="#19734B", constraint=false,
            label="VectorCommand en cabeza\nDisponibilidad / avance"
        ];
    }

    subgraph cluster_backend {
        label="Backend VPU: ejecución y almacenamiento";
        style="rounded,filled";
        color="#D8A85D"; fillcolor="#FFFAF0";
        fontname="DejaVu Sans"; fontsize=15; margin=20;

        subgraph cluster_lanes {
            label="Lane i (replicada N veces, progreso independiente)";
            style="rounded,filled";
            color="#D8A85D"; fillcolor="#FFF1D9";
            margin=20;

            lane [
                label=
                    "AraLane[i]\nCola de tareas / operand " +
                    "requester\nColas de operandos / writeback"
                ,
                fillcolor="#FFE6B9"
            ];
            alu [
                label="ALU local\nvadd.vv / vadd.vx\nEnteros de 32 bits",
                fillcolor="#FFE6B9"
            ];
            lrf [
                label=
                    "LaneRegisterFile[i]\nSlice local del VRF\nAcceso y " +
                    "arbitraje"
                ,
                fillcolor="#FFE6B9"
            ];
            banks [
                label=
                    "Bancos locales del VRF\nBancos / puertos " +
                    "configurables\nLatencia por banco; sin FIFO"
                ,
                fillcolor="#FFE6B9"
            ];

            lane -> alu [
                dir=both, color="#A66300",
                label="ExecutionBundle\nExecutionResult"
            ];
            lrf -> banks [
                dir=both, color="#A66300",
                label="Acceso mapeado\nDatos / ack / retry"
            ];
        }

        mapper [
            label=
                "AddressMapper\nRegla de mapeo compartida\nSin cola " +
                "ni latencia propia"
            ,
            fillcolor="#FFF0D2"
        ];
        lrf -> mapper [
            dir=both, color="#A66300",
            label=
                "Registro / desplazamiento / tamaño\nlane / banco / " +
                "fila / byteEnable"
        ];

        vlsu [label=
            "AraVLSU\nvle32.v / vse32.v unit-stride\nCorrelación " +
            "por TaskKey y requestId\nCompleta tras writeback / " +
            "ack de stores"
        ,
              fillcolor="#EAD8F3", color="#70458A"];

        { rank=same; lane; vlsu; }

        lane -> lrf [
            dir=both, color="#A66300",
            label=
                "Lectura de operandos / writeback\nReadResponse / " +
                "WriteAck / retry"
        ];
        vlsu -> lrf [
            dir=both, color="#70458A",
            label=
                "Escritura de cargas / lectura para " +
                "stores\nReadResponse / WriteAck / retry"
        ];
    }

    subgraph cluster_memory {
        label="Interfaz con la memoria de gem5";
        style="rounded,filled";
        color="#B38CC5"; fillcolor="#F5ECFA";
        fontname="DejaVu Sans"; fontsize=15; margin=20;

        mem_backend [label=
            "VectorMemoryBackend\nAdaptación a Request / " +
            "Packet\nTraducción, faults y retry"
        , fillcolor="#E1C9EE"];
        gem5_memory [label="TLB / puertos / memoria de gem5",
                     fillcolor="#EAD8F3"];

        mem_backend -> gem5_memory [
            dir=both, color="#70458A",
            label="Traducción y Request / Packet\nRespuestas / faults / retry"
        ];
    }

    cpu_if -> queue [
        dir=both, color="#0B4F8A", penwidth=2.2,
        label=
            "requestGrant / dispatch(token, VectorCommand)\ngrant " +
            "o stall / accepted"
    ];
    sequencer -> cpu_if [
        label="completed(VectorCompletion)",
        style=dashed, color="#536D7A", constraint=false
    ];
    sequencer -> distributor [
        dir=both, color="#19734B", penwidth=2.2, constraint=false,
        label=
            "ArithmeticTask\nDescriptor común: " +
            "UnitTask + TaskKey\nCapacidad / finalización agregada"
    ];
    // Consulta de cálculo; no se envía una UnitTask al mapper.
    distributor -> mapper [
        dir=both, color="#A66300", constraint=false,
        tailport=n, headport=n,
        label="Consulta de reparto\nLane propietaria"
    ];

    distributor -> lane [
        dir=both, color="#19734B",
        label="LaneTask + TaskKey\nCapacidad / finalización por lane"
    ];
    sequencer -> vlsu [
        dir=both, color="#70458A", penwidth=2.2,
        label=
            "MemoryTask\nUnitTask + TaskKey\nCapacidad / " +
            "UnitCompletion"
    ];
    vlsu -> mem_backend [
        dir=both, color="#70458A", penwidth=2.2,
        label=
            "VectorMemoryRequest\nTaskKey + requestId\n" +
            "VectorMemoryResponse"
    ];

    notes [
        shape=note, style=filled,
        fillcolor="#F5F6F7", color="#AEB7C2", fontsize=11,
        label=
            "CONVENCIONES Y ALCANCE\lFlecha doble: envío y " +
            "retorno; última línea = retorno.\lLane i y sus " +
            "bancos se replican N veces; el VRF no es " +
            "central.\lRuta elegida: VLSU accede al LRF de la " +
            "lane propietaria.\lComandos: CommandKey; tareas: " +
            "TaskKey.\lMemoria: TaskKey + requestId; futuro " +
            "RequestKey.\lBaseline: VectorRegRef " +
            "y rango de bytes.\lCon renombramiento: " +
            "PhysicalRegRef con versión y rango.\lSin " +
            "renombramiento, ROB ni chaining; validación inicial " +
            "funcional SE.\l"
    ];

    future [
        shape=note, style="filled,dashed",
        fillcolor="#F5F6F7", color="#AEB7C2", fontsize=11,
        label=
            "INTERCONEXIÓN Y AMPLIACIONES\lAraVLSU puede " +
            "consultar AddressMapper cuando " +
            "corresponda.\lVectorInterconnect: enlace ideal si se " +
            "necesita transportar datos.\lConecta lanes; puede " +
            "distribuir cargas VLSU a AraLane.\lEn esta vista se " +
            "usa el acceso directo VLSU-LRF.\l\lFUERA DEL PRIMER " +
            "HITO (sin conexiones activas)\lMUL / FPU; SLDU / " +
            "MASKU; reducciones y permutaciones.\lRenombramiento " +
            "al admitir: RAT + free-list + Vector ROB.\lROB: " +
            "retiro ordenado y liberación de versiones; no decide " +
            "issue.\lReadinessTable: bytes para datos y bits para " +
            "máscaras.\lChaining granular y topologías " +
            "temporizadas: fases posteriores.\l"
    ];

    { rank=same; lrf; alu; mem_backend; }
    { rank=same; mapper; banks; gem5_memory; notes; future; }

    // Orden visual; estas aristas no representan interfaces.
    gem5_memory -> notes -> future [style=invis];
}
